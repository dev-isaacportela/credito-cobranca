# Auto-populado pelo servidor (sandbox do Mitra) — NÃO hardcode valores.
# Localmente estas chaves ficam VAZIAS: o simulador não precisa delas e o mitra-sdk só roda no sandbox.
MITRA_BASE_URL=
MITRA_BASE_URL_INTEGRATIONS=
MITRA_TOKEN=
MITRA_PROJECT_ID=
MITRA_WORKSPACE_ID=

# Conexão JDBC do Winthor (add-002-jdbc-winthor.mjs, no sandbox) e Winthor real no simulador
# (SIMULATOR_WINTHOR=oracle). host:porta/serviço ou host:porta:sid, com ou sem jdbc:oracle:thin:@.
WINTHOR_JDBC_URL=
WINTHOR_USER=
WINTHOR_PASSWORD=
ORACLE_CLIENT_LIB_DIR=

# Topo da equipe criado pelo setup-backend.mjs quando CC_MEMBRO está vazia.
CC_ADMIN_NOME=
CC_ADMIN_EMAIL=
# Endereço do card nos e-mails do motor de quadros (add-001-kanban.mjs); precisa ter {id}.
CC_URL_DO_CARD=

# Só a confirmação no sandbox (sandbox/t002-confirmar.mjs, depois da publicação completa; ver CLAUDE.md).
# Token de sessão de um usuário business, membro ativo com a marca Administrador. Nunca VITE_, nunca commitado.
T002_BUSINESS_TOKEN=
# Caixa que recebe o e-mail de teste do S-11.
T002_EMAIL=

# Só o simulador local (backend/simulator). Vazios = padrão.
SIMULATOR_PORT=
SIMULATOR_DB_PATH=
SIMULATOR_PASSWORD=
SIMULATOR_PROJECT_ID=
# oracle = SQL do Winthor no Oracle real (precisa das WINTHOR_* acima); vazio = PC* no SQLite.
SIMULATOR_WINTHOR=
# 1 = chamada aninhada leva a sessão de quem chamou (DT-34); vazio/0 = sem sessão (padrão).
SIM_SESSAO_ANINHADA=
# Relógio do simulador (hora de Brasília); vazio = 2026-11-19T10:00:00 (D).
CC_AGORA=
